	<key>NSContactsUsageDescription</key>
	<string>Cho phép ứng dụng bên trong SIContainer truy cập Danh bạ.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Cho phép ứng dụng bên trong SIContainer xác thực bằng Face ID.</string>
	<key>NSLocalNetworkUsageDescription</key>
