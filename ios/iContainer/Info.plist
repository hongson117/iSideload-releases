	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cho phép ứng dụng bên trong SIContainer truy cập Thư viện ảnh khi bạn sử dụng.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Cho phép ứng dụng bên trong SIContainer truy cập Lời nhắc.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
