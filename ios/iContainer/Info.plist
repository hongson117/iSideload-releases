	<array>
		<string>sicontainer-runner1</string>
		<string>sicontainer-runner2</string>
		<string>localdevvpn</string>
		<string>livecontainer</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Cho phép ứng dụng bên trong SIContainer kết nối Bluetooth.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
